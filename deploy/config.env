# Configuración del despliegue. La leen deploy/cloudrun.sh y deploy/cloudflare-pages.sh.
# No contiene secretos: se puede guardar en git.
#
# Cada línea tiene la forma  VARIABLE="${VARIABLE:-valor}": edita solo lo que va después de ":-".
# Así también se puede cambiar un valor al llamar al script, p. ej.: MAX_INSTANCES=5 deploy/cloudrun.sh

# --- Google Cloud Run (API de conversión) ---

# ID del proyecto de Google Cloud (obligatorio), p. ej. "${PROJECT_ID:-epubtailor-123456}"
PROJECT_ID="${PROJECT_ID:-epub-tailor}"
# Región con precios Tier 1. Alternativa cercana a Colombia: northamerica-south1
REGION="${REGION:-us-east1}"
# Nombre del servicio en Cloud Run
SERVICE="${SERVICE:-epubtailor-api}"
# Tope de instancias = tope de conversiones simultáneas y del gasto
MAX_INSTANCES="${MAX_INSTANCES:-3}"
# Tamaño máximo del PDF. Cloud Run no admite peticiones de más de 32 MiB por HTTP/1
MAX_MB="${MAX_MB:-30}"
MAX_PAGES="${MAX_PAGES:-800}"
# Dominios desde los que la página puede llamar a la API, separados por comas:
# la dirección de Cloudflare Pages y, si lo tienes, tu dominio propio.
ALLOWED_ORIGINS="${ALLOWED_ORIGINS:-https://epubtailor.pages.dev}"

# --- Cloudflare Pages (página de inicio) ---

# Nombre del proyecto en Cloudflare Pages: la página queda en https://<nombre>.pages.dev
PAGES_PROJECT="${PAGES_PROJECT:-epubtailor}"
# URL de la API. Vacío: se le pregunta a gcloud por la URL del servicio de Cloud Run.
API_URL="${API_URL:-}"
